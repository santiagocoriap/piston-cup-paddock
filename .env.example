# Copy this file to .env and change every value marked CHANGE.
DJANGO_SECRET_KEY=CHANGE-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Add the public URL when you deploy, for example https://paddock.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8420
POSTGRES_DB=paddock
POSTGRES_USER=paddock
POSTGRES_PASSWORD=CHANGE-to-a-long-random-value
# Set to 1 behind the Coolify proxy. Keep 0 when nothing is in front of the app.
# The public URL of the app. The game of each driver loads the Paddock script from it.
# Empty: the address in the browser of the admin (localhost works only for the same PC).
PUBLIC_URL=
TRUSTED_PROXY_COUNT=0

# AI race reports (optional). Without a key the app works with no reports.
# AI_REPORT_MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# Only when the key has no workspace: the workspace ID from the Anthropic Console.
# ANTHROPIC_WORKSPACE_ID=

# Local tools outside Docker (tests, runserver) connect through this port.
POSTGRES_PORT=55432
